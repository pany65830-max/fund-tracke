# ===== 本地抓取侧配置模板 =====
# 复制为同目录 .env 后填写（.env 不会被提交，见 .gitignore）

# 【必需】iFinD refresh_token（同花顺 iFinD Excel 插件登录后获取）
# 用于拉取 ETF 实时行情与资金数据。没有它行情为空，但官网/交易所/微信资讯照常抓。
IFIND_REFRESH_TOKEN=

# 【可选】微信 WeWe RSS 本机服务地址与鉴权码
# 起 Docker 后默认 http://127.0.0.1:4000；经 cloudflared 隧道暴露后改为公网地址
WEWE_RSS_URL=http://127.0.0.1:4000
WEWE_AUTH_CODE=

# 【可选】本地抓取代理（A1 方案）
# 仅当你想让海外云端 Worker 借你电脑的国内 IP 抓四家/交易所时才配。
# 不配则云端抓不全（由本机定时任务兜底，合并逻辑保留已有数据）。
SCRAPE_PROXY_URL=
SCRAPE_PROXY_TOKEN=

# 【可选】iFinD 接口地址（一般不用改）
# IFIND_BASE_URL=https://quantapi.51ifind.com/api/v1
